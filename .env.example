NODE_ENV=production
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=flowguard_user
DB_PASSWORD=CHANGE_ME
DB_NAME=flowguard_prod
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=7d

# ── AI risk-briefing layer (optional) ──────────────────────────────
# Leave unset and /ai/brief still works via a plain-text template.
# Set these to turn on real generated briefings. Start free on Groq
# (console.groq.com, no card); switch to Claude later by changing these 3.
LLM_PROVIDER=groq                        # groq | openrouter | gemini | anthropic
LLM_API_KEY=CHANGE_ME                     # your provider key (kept ONLY in this file, never in git)
LLM_MODEL=openai/gpt-oss-20b              # a CURRENT model from your provider's list (Groq deprecates IDs)
